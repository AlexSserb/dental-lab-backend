DATABASE_NAME=DatabaseName
DATABASE_USER=DatabaseUser
DATABASE_PASSWORD=DatabasePassword
DATABASE_HOST=localhost
DATABASE_PORT=5432
SECRET_KEY=your_secret_key
EMAIL_HOST_USER=example@yandex.ru
EMAIL_HOST_PASSWORD=EmailHostPassword
CLIENT_URL=https://example.com

DEBUG=True
# Comma-separated hosts / origins; add the server address when deploying (EC2 public IP or domain)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost
# Load demo users, customers and work catalog on container start (not for production)
LOAD_DEMO_DATA=true
