DATABASE_NAME=DatabaseName
DATABASE_USER=DatabaseUser
DATABASE_PASSWORD=DatabasePassword
DATABASE_HOST=localhost
DATABASE_PORT=5432
SECRET_KEY=your_secret_key
EMAIL_HOST_USER=example@yandex.ru
EMAIL_HOST_PASSWORD=EmailHostPassword
CLIENT_URL=https://example.com

DEBUG=True
# Comma-separated hosts / origins; add the server address when deploying (EC2 public IP or domain)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost
# Load demo users, customers and work catalog on container start (not for production)
LOAD_DEMO_DATA=true

AI_BASE_URL=http://localhost:11434/v1
AI_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:3b-instruct
AI_TIMEOUT_S=60
AI_MAX_RETRIES=2
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0

# Knowledge base (RAG)
EMBEDDING_MODEL=bge-m3
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_DISTANCE=0.55
KNOWLEDGE_ASK_RATE=60/hour
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_CANDIDATES=20
KNOWLEDGE_MIN_RERANK_SCORE=-5.0

LANGSMITH_API_KEY=
# Tracing: when true, every LangGraph run and LLM call is traced to LangSmith (grouped under LANGSMITH_PROJECT)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=dental-lab
PROMPT_SOURCE=local
PROMPT_TAG=production
PROMPT_CACHE_TTL_S=300
PROMPT_FAILURE_BACKOFF_S=60

# How many times the administrator may send a proposal back before the workflow goes to manual review
DEFECT_MAX_REVISIONS=2
# Propose runs only when classification confidence is at least this (low < medium < high); below goes to a human
DEFECT_MIN_CONFIDENCE=medium
# Poll interval (seconds) of `manage.py run_defect_worker` when there is nothing to do
DEFECT_WORKER_POLL_S=2
# When set, the "defect found" email goes to this address instead of the ordering doctor
DEFECT_NOTIFY_EMAIL=
